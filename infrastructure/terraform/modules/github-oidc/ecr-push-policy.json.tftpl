{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrRegistryAuthentication",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushApplicationImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:${region}:${account_id}:repository/url-shortner-frontend",
        "arn:aws:ecr:${region}:${account_id}:repository/url-shortner-url-service",
        "arn:aws:ecr:${region}:${account_id}:repository/url-shortner-analytics-service"
      ]
    }
  ]
}
